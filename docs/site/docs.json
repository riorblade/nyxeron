{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "NYXERON",
  "description": "NYXERON · Nightclub Empire: a multiplayer nightclub game on BNB Chain where the drinks are tokenized stocks.",
  "colors": {
    "primary": "#DD47FC",
    "light": "#E58CFF",
    "dark": "#914DFF"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#120826",
      "dark": "#090319"
    }
  },
  "fonts": {
    "family": "Geist",
    "heading": {
      "family": "Inter Tight",
      "weight": 700
    },
    "body": {
      "family": "Geist"
    }
  },
  "styling": {
    "codeblocks": "dark"
  },
  "logo": {
    "light": "/logo/mark-black.svg",
    "dark": "/logo/mark-white.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "@nyxeron_xyz",
        "icon": "x-twitter",
        "href": "https://x.com/nyxeron_xyz"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Play now",
      "href": "https://nyxeron.xyz"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "how-to-play",
          "catalog",
          "faq"
        ]
      },
      {
        "group": "Game mechanics",
        "pages": [
          "engine/night-loop",
          "engine/guests",
          "engine/crowd",
          "engine/market",
          "engine/economy"
        ]
      },
      {
        "group": "On-chain",
        "pages": [
          "economy/real-money"
        ]
      },
      {
        "group": "Technology",
        "pages": [
          "architecture",
          "multiplayer-live",
          "tech-stack"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nyxeron_xyz",
      "website": "https://nyxeron.xyz"
    }
  }
}
