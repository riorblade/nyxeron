# Copy to apps/agent/.env (never commit it). The owner hands over AGENT_KEY privately.
# The api's stock agent secret (the same value as AGENT_KEY in deploy/.env).
AGENT_KEY=
# The api. Dev: `pnpm dev:api` on :8788. Must be https except for localhost.
NYXERON_API=http://localhost:8788
# Budget per restock in USDC on BSC; capped by agent.maxUsdPerSwap in packages/core/src/data/payments.json.
AGENT_BUY_USD=3
# Where the agent records the swap it placed until the api counts it (default apps/agent/agent-state.json).
AGENT_STATE=
