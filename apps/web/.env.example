# Copy to apps/web/.env.local for local development (never commit .env.local).
# Privy app id (public): https://dashboard.privy.io. Without it the game runs signed-out (no account features).
VITE_PRIVY_APP_ID=
# Leave empty in dev: Vite proxies /api → :8788 and /ws → :8787 (pnpm dev:api, pnpm dev:relay).
# Production values live in .env.production.
VITE_API_BASE=
VITE_RELAY_URL=
