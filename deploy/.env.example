# Copy to deploy/.env on the server (never commit it). docker compose reads it automatically.
# Your domain, pointed at the VPS (A/AAAA record). Caddy gets the HTTPS certificate by itself.
DOMAIN=nyxeron.example.com
# Binance Web3 API (https://web3.binance.com/en/dev-portal/project). Only the api service sees these.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=
# Only with compose.behind-proxy.yml: the Docker network of the proxy that owns 80/443.
GATEWAY_NETWORK=deploy_default
