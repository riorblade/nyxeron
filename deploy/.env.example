# Copy to deploy/.env on the server (never commit it). docker compose reads it automatically.
# Your domain, pointed at the VPS (A/AAAA record). Caddy gets the HTTPS certificate by itself.
DOMAIN=nyxeron.example.com
# Binance Web3 API (https://web3.binance.com/en/dev-portal/project). Only the api service sees these.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=
# Only with compose.behind-proxy.yml: the Docker network of the proxy that owns 80/443.
GATEWAY_NETWORK=deploy_default
# Only with compose.backend.yml (frontend on Vercel): another site allowed to use the relay/API, e.g. the
# project's Vercel URL.
FRONTEND_EXTRA_HOST=nyxeron.vercel.app
# Privy (https://dashboard.privy.io): app id (public) and app secret (server only) for verifying sign-ins.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Back office (apps/admin): owner emails (comma-separated) and its site, allowed to call the API.
ADMIN_EMAILS=
ADMIN_HOST=admin.nyxeron.example.com
