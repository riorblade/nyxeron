# The only public entry point: HTTPS (automatic certificates), compression, the static game, and two internal
# services behind it. The relay and the api are never exposed directly.
{
	# Small, quiet edge: no admin API on the network.
	admin off
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# Multiplayer relay (WebSocket). Caddy upgrades and proxies it as-is.
	handle /ws {
		reverse_proxy relay:8787
	}

	# Game API (spot quotes today).
	handle /api/* {
		reverse_proxy api:8788
	}

	# Hashed JS/CSS: cache forever. A missing one is a plain 404, never cached, never the app shell.
	handle /assets/* {
		root * /srv
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		# Real files (art, audio, video, favicon…): a day.
		@media {
			file
			not path / /index.html
		}
		handle @media {
			header Cache-Control "public, max-age=86400"
			file_server
		}
		# Everything else is the app shell: always revalidated, so a deploy shows up at once.
		handle {
			header Cache-Control "no-cache"
			rewrite * /index.html
			file_server
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
